# Banco de dados (Supabase Postgres).
# DATABASE_URL: pooler em modo transaction (porta 6543) - usado pela aplicação em runtime (Prisma Client).
# DIRECT_URL: pooler em modo session (porta 5432) - necessário para o Prisma Migrate (DDL não funciona via transaction pooler).
DATABASE_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Stripe (assinaturas do SaaS)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend (e-mails transacionais)
RESEND_API_KEY=""
