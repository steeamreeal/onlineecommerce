# Domínio raiz da plataforma (sem protocolo, sem porta), usado pelo
# middleware para diferenciar acesso à plataforma (painel/admin/marketing)
# de subdomínio de loja ({slug}.NEXT_PUBLIC_PLATFORM_DOMAIN) e domínio
# próprio do lojista. Em dev local use "localhost:3000".
NEXT_PUBLIC_PLATFORM_DOMAIN="plataforma.com"

# Banco de dados (Supabase Postgres).
# DATABASE_URL: pooler em modo transaction (porta 6543) - usado pela aplicação em runtime (Prisma Client).
# DIRECT_URL: pooler em modo session (porta 5432) - necessário para o Prisma Migrate (DDL não funciona via transaction pooler).
# O script "build" roda "prisma migrate deploy" antes do "next build" — na
# Vercel, DIRECT_URL precisa estar disponível como env var de BUILD (não só
# runtime), senão o deploy falha ao tentar aplicar migrations pendentes.
DATABASE_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase (auth)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# E-mails com acesso ao painel administrativo do SaaS ((admin)), separados por vírgula.
# Usado só para o BOOTSTRAP do primeiro super admin: quando um desses e-mails faz
# login pela primeira vez (auth.sincronizarUsuario), Usuario.papelAdmin é
# preenchido automaticamente com SUPER_ADMIN. Dali em diante, quem gerencia
# acesso ao admin é o próprio painel (admin.convidarUsuarioPlataforma), que
# grava direto em Usuario.papelAdmin — não precisa editar esta variável de novo.
ADMIN_EMAILS=""

# Stripe (assinaturas do SaaS)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Mercado Pago Connect (checkout da loja: PIX, cartão, boleto). Credenciais
# do aplicativo da PLATAFORMA no Mercado Pago (não é o token de uma loja) —
# usadas para o fluxo OAuth em que cada lojista conecta sua própria conta.
# O dinheiro do checkout cai direto na conta do lojista, nunca numa conta
# central da plataforma (ver Loja.mpAccessToken em schema.prisma).
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Resend (e-mails transacionais)
RESEND_API_KEY=""
# Remetente usado nos e-mails (precisa ser um domínio verificado no Resend).
RESEND_FROM_EMAIL="Loja <pedidos@seudominio.com>"

# Vercel Domains API — cadastra automaticamente o domínio próprio de cada
# loja (Loja.dominioProprio) no projeto da plataforma na Vercel quando o
# lojista salva em Configurações → Domínio personalizado, sem o admin
# precisar entrar manualmente em Settings → Domains a cada cliente novo.
# Opcional: sem essas variáveis, o cadastro volta a ser manual pelo admin.
# VERCEL_API_TOKEN: token pessoal/de time com permissão no projeto (criar em
# https://vercel.com/account/tokens).
# VERCEL_PROJECT_ID: id do projeto na Vercel (Project Settings → General).
# VERCEL_TEAM_ID: só necessário se o projeto pertence a um time (não conta pessoal).
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""
