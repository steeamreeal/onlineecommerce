datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ---------- Plataforma (SaaS) ----------

enum PlanoStatus {
  ATIVO
  BLOQUEADO
  CANCELADO
  TESTE
}

// Papel de um Usuario dentro do painel administrativo do SaaS (dono da
// plataforma), não confundir com PapelUsuario (papel dentro de uma Loja).
enum PapelAdmin {
  SUPER_ADMIN
  SUPORTE
  FINANCEIRO
}

model Plano {
  id             String   @id @default(cuid())
  nome           String
  limiteProdutos Int?
  limiteUsuarios Int?
  precoMensal    Decimal  @db.Decimal(10, 2)
  stripePriceId  String?
  features       String[] @default([])
  lojas          Loja[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------- Tenant (Loja) ----------

enum TemplateLoja {
  MINIMALISTA
  EDITORIAL
  VITRINE
}

model Loja {
  id             String       @id @default(cuid())
  nome           String
  slug           String       @unique
  responsavel    String?
  emailContato   String?
  logoUrl        String?
  corPrimaria    String?
  template       TemplateLoja @default(MINIMALISTA)
  banners        Json?
  temaConfig     Json?
  whatsapp       String?
  instagram      String?
  facebook       String?
  endereco       String?
  horarioAtend   String?
  politicas      String?
  dominioProprio String?      @unique
  planoId        String?
  plano          Plano?       @relation(fields: [planoId], references: [id])
  statusPlano    PlanoStatus  @default(TESTE)

  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  // Credenciais do Mercado Pago Connect da própria loja (OAuth) — o dinheiro
  // do checkout cai direto na conta do lojista, nunca numa conta central da
  // plataforma. Nulos até o lojista concluir "Conectar Mercado Pago".
  mpAccessToken  String?   @unique
  mpRefreshToken String?
  mpUserId       String?   @unique
  mpConectadoEm  DateTime?

  usuarios     UsuarioLoja[]
  convites     ConviteUsuarioLoja[]
  produtos     Produto[]
  categorias   Categoria[]
  clientes     Cliente[]
  pedidos      Pedido[]
  cupons       Cupom[]
  opcoesFrete  OpcaoFrete[]
  notificacoes Notificacao[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Usuários e permissões ----------

enum PapelUsuario {
  // Acima de ADMINISTRADOR: único por loja, não pode ser removido nem ter o
  // próprio papel alterado por outro usuário (nem por outro ADMINISTRADOR)
  // — só o próprio DONO pode transferir esse papel para outra pessoa. Ver
  // regras em server/trpc/routers/usuarios-loja.ts.
  DONO
  ADMINISTRADOR
  GERENTE
  VENDEDOR
  ESTOQUISTA
  SEPARADOR
}

model Usuario {
  id         String        @id @default(cuid())
  nome       String
  email      String        @unique
  supabaseId String        @unique
  // Null = não é usuário da plataforma (só lojista). Preenchido = tem acesso
  // ao painel admin do SaaS com este papel — independente de UsuarioLoja.
  papelAdmin PapelAdmin?
  lojas      UsuarioLoja[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model UsuarioLoja {
  id        String       @id @default(cuid())
  usuarioId String
  usuario   Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  lojaId    String
  loja      Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  papel     PapelUsuario

  createdAt DateTime @default(now())

  @@unique([usuarioId, lojaId])
}

// Convite pendente de um e-mail para entrar na equipe de uma loja. Diferente
// de admin.concederAcessoPlataforma (que exige que o Usuario já exista): aqui
// a pessoa convidada pode nunca ter feito login — o convite carrega email +
// papel até que alguém aceite pelo token, criando/vinculando o Usuario nesse
// momento (ver usuariosLoja.aceitarConvite).
model ConviteUsuarioLoja {
  id        String       @id @default(cuid())
  email     String
  lojaId    String
  loja      Loja         @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  papel     PapelUsuario
  token     String       @unique
  expiraEm  DateTime
  aceitoEm  DateTime?

  createdAt DateTime @default(now())

  @@unique([lojaId, email])
}

// ---------- Catálogo ----------

model Categoria {
  id       String    @id @default(cuid())
  lojaId   String
  loja     Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome     String
  produtos Produto[]
  cupons   Cupom[]   @relation("CupomCategorias")

  @@unique([lojaId, nome])
}

enum StatusProduto {
  ATIVO
  INATIVO
  DESTAQUE
}

model Produto {
  id             String            @id @default(cuid())
  lojaId         String
  loja           Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome           String
  descricao      String?
  codigo         String?
  precoNormal    Decimal           @db.Decimal(10, 2)
  precoPromo     Decimal?          @db.Decimal(10, 2)
  pesoGramas     Int?
  alturaCm       Int?
  larguraCm      Int?
  profundidadeCm Int?
  status         StatusProduto     @default(ATIVO)
  categoriaId    String?
  categoria      Categoria?        @relation(fields: [categoriaId], references: [id])
  fotos          FotoProduto[]
  variacoes      VariacaoProduto[]
  itensPedido    ItemPedido[]
  cupons         Cupom[]           @relation("CupomProdutos")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId, status])
}

enum TipoMidiaProduto {
  IMAGEM
  VIDEO
}

model FotoProduto {
  id         String            @id @default(cuid())
  produtoId  String
  produto    Produto           @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  url        String
  ordem      Int               @default(0)
  tipo       TipoMidiaProduto  @default(IMAGEM)
  variacoes  VariacaoProduto[]
}

model VariacaoProduto {
  id          String             @id @default(cuid())
  produtoId   String
  produto     Produto            @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  cor         String?
  tamanho     String?
  modelo      String?
  estoque     Int                @default(0)
  fotoId      String?
  foto        FotoProduto?       @relation(fields: [fotoId], references: [id], onDelete: SetNull)
  itensPedido ItemPedido[]
  movimentos  MovimentoEstoque[]

  @@index([produtoId])
  @@index([fotoId])
}

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA
}

model MovimentoEstoque {
  id         String               @id @default(cuid())
  variacaoId String
  variacao   VariacaoProduto      @relation(fields: [variacaoId], references: [id], onDelete: Cascade)
  quantidade Int
  tipo       TipoMovimentoEstoque
  motivo     String?
  createdAt  DateTime             @default(now())

  @@index([variacaoId])
}

// ---------- Clientes ----------

model Cliente {
  id        String            @id @default(cuid())
  lojaId    String
  loja      Loja              @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  nome      String
  telefone  String?
  email     String?
  documento String? // CPF ou CNPJ
  enderecos EnderecoCliente[]
  pedidos   Pedido[]

  // Histórico de compras anteriores ao site (WhatsApp/Instagram), informado
  // manualmente pelo lojista — não tem Pedido real associado. O resumo de
  // compras exibido no painel soma isso aos pedidos feitos pelo site.
  totalGastoAnterior     Decimal?  @db.Decimal(10, 2)
  ultimaCompraAnterior   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId])
}

model EnderecoCliente {
  id        String  @id @default(cuid())
  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  rua       String
  numero    String?
  bairro    String?
  cidade    String
  estado    String
  cep       String
  principal Boolean @default(false)
}

// ---------- Frete ----------

model OpcaoFrete {
  id                 String   @id @default(cuid())
  lojaId             String
  loja               Loja     @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  tipo               String // RETIRADA | ENTREGA_PROPRIA | FIXO | FAIXA_BAIRRO | FAIXA_CIDADE | CORREIOS
  nome               String
  valor              Decimal? @db.Decimal(10, 2)
  freteGratisAcimaDe Decimal? @db.Decimal(10, 2)
  ativo              Boolean  @default(true)
}

// ---------- Cupons ----------

enum TipoCupom {
  PERCENTUAL
  VALOR_FIXO
  FRETE_GRATIS
}

model Cupom {
  id         String    @id @default(cuid())
  lojaId     String
  loja       Loja      @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  codigo     String
  tipo       TipoCupom
  valor      Decimal?  @db.Decimal(10, 2)
  inicio     DateTime
  fim        DateTime
  limiteUso  Int?
  usosAtuais Int       @default(0)
  pedidos    Pedido[]

  // Vazio = aplica-se à loja inteira. Preenchido = restrito aos produtos/categorias listados.
  produtos   Produto[]   @relation("CupomProdutos")
  categorias Categoria[] @relation("CupomCategorias")

  @@unique([lojaId, codigo])
}

// ---------- Pedidos ----------

enum StatusPedido {
  NOVO
  AGUARDANDO_PAGAMENTO
  PAGO
  EM_PREPARACAO
  ENVIADO
  PRONTO_RETIRADA
  ENTREGUE
  CANCELADO
}

enum FormaPagamento {
  PIX
  CARTAO
  BOLETO
  LINK_PAGAMENTO
  PAGAMENTO_ENTREGA
}

model Pedido {
  id             String         @id @default(cuid())
  lojaId         String
  loja           Loja           @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  clienteId      String
  cliente        Cliente        @relation(fields: [clienteId], references: [id])
  status         StatusPedido   @default(NOVO)
  formaPagamento FormaPagamento
  valorFrete     Decimal        @default(0) @db.Decimal(10, 2)
  valorDesconto  Decimal        @default(0) @db.Decimal(10, 2)
  valorTotal     Decimal        @db.Decimal(10, 2)
  cupomId        String?
  cupom          Cupom?         @relation(fields: [cupomId], references: [id])
  codigoRastreio String?
  itens          ItemPedido[]

  mpPaymentId   String?   @unique
  linkPagamento String?
  pagoEm        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lojaId, status])
}

model ItemPedido {
  id         String           @id @default(cuid())
  pedidoId   String
  pedido     Pedido           @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  produtoId  String
  produto    Produto          @relation(fields: [produtoId], references: [id])
  variacaoId String?
  variacao   VariacaoProduto? @relation(fields: [variacaoId], references: [id])
  quantidade Int
  precoUnit  Decimal          @db.Decimal(10, 2)
}

// ---------- Notificações in-app ----------

enum TipoNotificacao {
  PEDIDO_NOVO
  ESTOQUE_BAIXO
  STATUS_ATUALIZADO
}

model Notificacao {
  id        String          @id @default(cuid())
  lojaId    String
  loja      Loja            @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String
  mensagem  String
  lida      Boolean         @default(false)
  pedidoId  String?
  createdAt DateTime        @default(now())

  @@index([lojaId, lida])
}

// ---------- Webhooks ----------

enum OrigemWebhook {
  STRIPE
  MERCADO_PAGO
}

// Registro de eventos de webhook já processados, usado para garantir
// idempotência (gateways podem reenviar o mesmo evento mais de uma vez).
model WebhookEvent {
  id        String        @id @default(cuid())
  origem    OrigemWebhook
  eventoId  String
  createdAt DateTime      @default(now())

  @@unique([origem, eventoId])
}
